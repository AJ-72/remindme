+   * Two independent JS flags, both reaching native as NotificationContent
+   * body (Expo maps JS `content.data` onto `body`):
+   *   - `alarm`      -- rings out loud. Absent => false.
+   *   - `exactTiming`-- arrives on time. Absent => TRUE, so notifications
+   *                     scheduled before this field existed (and any already
+   *                     sitting in the tray across the upgrade) stay punctual
+   *                     rather than silently regressing to inexact.
+   */
+  private fun isAlarmReminder(request: NotificationRequest): Boolean {
+    val body = request.content?.body ?: return true
+    return body.optBoolean("alarm", false) || body.optBoolean("exactTiming", true)
+  }
